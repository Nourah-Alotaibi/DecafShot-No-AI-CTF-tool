+def _find_ret_gadget(binary_name):
+    """Find a plain 'ret' (0xc3) instruction address in an executable
+    section, via objdump -d. Used only as a stack-alignment fallback for
+    the point-to-win technique below — see the comment at its call site.
+    Best-effort: returns None on any failure so callers can just skip the
+    retry instead of raising.
+    """
+    try:
+        out = subprocess.run(
+            ["objdump", "-d", binary_name],
+            capture_output=True, text=True, timeout=15,
+        ).stdout
+        for line in out.splitlines():
+            line = line.strip()
+            if line.endswith("ret") and ":" in line:
+                addr_str = line.split(":")[0].strip()
+                try:
+                    return int(addr_str, 16)
+                except ValueError:
+                    continue
+    except Exception:
+        pass
+    return None
+
